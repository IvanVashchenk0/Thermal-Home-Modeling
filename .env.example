# Executable name on PATH or an absolute path; do not include shell quotes/flags.
ENERGYPLUS_EXE=energyplus
# Relative paths below are resolved against the project root, never the shell cwd.
THM_DATA_DIR=data
THM_BASELINE_MODEL=data/baseline_models/baseline.epJSON
THM_BASELINE_PARAMETERS=data/baseline_models/baseline_parameters.json
THM_TIMEOUT_SECONDS=3600
# Optional individual overrides:
# THM_WEATHER_DIR=data/weather
# THM_GENERATED_MODELS_DIR=data/generated_models
# THM_OUTPUT_DIR=data/simulation_outputs
# THM_RESULTS_DIR=data/results
